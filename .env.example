APP_NAME=MovieMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

MOVIEMATE_AI_ENABLED=false
MOVIEMATE_AI_PROVIDER=openai
MOVIEMATE_AI_MODEL=
MOVIEMATE_AI_TIMEOUT=20
MOVIEMATE_AI_CONTEXT_MESSAGES=12
MOVIEMATE_AI_CONTEXT_CHARACTERS=6000
MOVIEMATE_AI_MAX_RESPONSE_CHARACTERS=6000
OPENAI_API_KEY=
GEMINI_API_KEY=
NINE_ROUTER_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CONNECT_TIMEOUT_SECONDS=3
PAYOS_REQUEST_TIMEOUT_SECONDS=10

# HTTPS tunnels need trusted forwarded headers. Production must use explicit
# proxy IP addresses/CIDR ranges; wildcard mode is an opt-in local-only escape hatch.
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES_ALLOW_LOCAL_WILDCARD=false
# Exact additional public hosts, comma-separated. APP_URL and PAYMENT_PUBLIC_HOSTS
# are included automatically.
TRUSTED_HOSTS=

CINEMA_TIMEZONE=Asia/Ho_Chi_Minh
CINEMA_CLEANING_BUFFER_MINUTES=15
BOOKING_PENDING_TTL_MINUTES=15
BOOKING_CHECKOUT_TOKEN_TTL_MINUTES=15
BOOKING_EXPIRATION_BATCH_SIZE=100
BOOKING_GUEST_ACCESS_TTL_MINUTES=1440
BOOKING_GUEST_SESSION_TTL_MINUTES=60
BOOKING_TICKET_EMAIL_ACCESS_TTL_MINUTES=10080
BOOKING_FOOD_MUTATION_MAX_ATTEMPTS=6
BOOKING_MAX_LOGICAL_SEAT_UNITS=8
BOOKING_HOLD_CREATION_MAX_ATTEMPTS=4
BOOKING_HOLD_CREATION_WINDOW_MINUTES=10
BOOKING_HOLD_CREATION_NETWORK_MAX_ATTEMPTS=20
MAX_DISCOUNT_CODES_PER_BOOKING=3

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moviemate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=moviemate-session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development only. Production must use a graph whose every leaf is an
# explicitly approved real delivery transport; log and array are forbidden.
# The log mailer records the HTML locally and does not deliver to an inbox.
MAIL_MAILER=log
MAIL_PRODUCTION_ALLOWED_TRANSPORTS=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_URL=
MAIL_EHLO_DOMAIN=localhost
MAIL_FROM_ADDRESS="no-reply@moviemate.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMENT_DRIVER=vnpay
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_BANK_CODE=
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_PAYMENT_TTL_MINUTES=15
VNPAY_HTTP_TIMEOUT_SECONDS=10
VNPAY_QUERY_INTERVAL_SECONDS=60
VNPAY_QUERY_IP=127.0.0.1
ZALOPAY_ENV=sandbox
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=
ZALOPAY_REDIRECT_URL=
ZALOPAY_EXPIRE_DURATION_SECONDS=600
ZALOPAY_HTTP_TIMEOUT_SECONDS=10
ZALOPAY_QUERY_INTERVAL_SECONDS=60
ZALOPAY_SUB_APP_ID=
ZALOPAY_ZLP_PAYMENT_ID=
ZALOPAY_BANK_CODE=
PAYMENT_RECONCILIATION_GRACE_HOURS=24
PAYMENT_RETURN_STATE_TTL_MINUTES=30
# Required in production; comma-separated public hosts allowed for callback/return.
PAYMENT_PUBLIC_HOSTS=
TICKET_DELIVERY_BATCH_SIZE=100
TICKET_DELIVERY_LEASE_SECONDS=300
TICKET_DELIVERY_BACKOFF_BASE_SECONDS=60
TICKET_DELIVERY_BACKOFF_MAX_SECONDS=3600

# Optional Laravel/infrastructure overrides. Leave blank unless that driver is used.
APP_PREVIOUS_KEYS=
APP_MAINTENANCE_STORE=database
AUTH_GUARD=web
AUTH_MODEL="App\\Models\\User"
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
MYSQL_ATTR_SSL_CA=
CACHE_PREFIX=
DYNAMODB_CACHE_TABLE=
DYNAMODB_ENDPOINT=
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PORT=11211
REDIS_URL=
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
SQS_PREFIX=
